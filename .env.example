# 复制成 .env.local 后填入真实值（.env.local 已被 .gitignore 忽略）
#
# anon / publishable key 是**设计上就要发给浏览器的**，安全性由数据库 RLS 保证。
# 真正不能进前端的是 service_role key —— 那个能绕过所有 RLS，只在本机脚本里用。
#
# ⚠️ Vite 的 import.meta.env.VITE_* 是**构建时**做静态替换的，
#    改完要重启 dev server / 重新 build，热更新不会生效。

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon 或 publishable key>
